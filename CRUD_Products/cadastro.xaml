<Window x:Class="CRUD_Products.cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_Products"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="cadastro" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/image (1).png"/>
        </Grid.Background>
        <TextBox x:Name="nome" HorizontalAlignment="Center" Margin="0,109,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="quantidade" HorizontalAlignment="Center" Margin="0,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.052,-0.153" TextChanged="quantidade_TextChanged"/>
        <TextBox x:Name="preco" HorizontalAlignment="Center" Margin="0,254,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="classifica" HorizontalAlignment="Center" Margin="0,344,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Content="cadastrar" HorizontalAlignment="Center" Margin="0,367,0,0" VerticalAlignment="Top" Click="Button_Click" Height="28" Width="78"/>
        <Button Content="" HorizontalAlignment="Left" Margin="673,10,0,0" VerticalAlignment="Top" Click="Button_Click_1" Width="117" Background="{x:Null}"/>

    </Grid>
</Window>
