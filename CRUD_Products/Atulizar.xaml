<Window x:Class="CRUD_Products.Atulizar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_Products"
        mc:Ignorable="d"
        Title="Atulizar" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/image (4).png"/>
        </Grid.Background>
        <Button Content="Central" HorizontalAlignment="Left" Margin="729,46,0,0" VerticalAlignment="Top" Click="Button_Click" RenderTransformOrigin="1.676,-0.098"/>
        <TextBox x:Name="nome" HorizontalAlignment="Center" Margin="0,137,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="nome_TextChanged"/>
        <TextBox x:Name="quantidade" HorizontalAlignment="Center" Margin="0,228,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="quantidade_TextChanged"/>
        <TextBox x:Name="preco" HorizontalAlignment="Center" Margin="0,312,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button Content="Atualizar" HorizontalAlignment="Center" Margin="0,394,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>

    </Grid>
</Window>
